{
  "name": "oracle-node",
  "private": true,
  "workspaces": [
    "prepare/lambdas/*",
    "workflow/lambdas/*",
    "workflow-events/lambdas/*",
    "budget-alert/lambdas/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "npm run typecheck --workspace=prepare/lambdas/downloader && npm run typecheck --workspace=prepare/lambdas/updater && npm run typecheck --workspace=workflow/lambdas/pre && npm run typecheck --workspace=workflow/lambdas/starter && npm run typecheck --workspace=workflow/lambdas/submit && npm run typecheck --workspace=workflow/lambdas/error-resolver && npm run typecheck --workspace=workflow/lambdas/permit-harvest-worker && npm run typecheck --workspace=workflow-events/lambdas/event-handler && npm run typecheck --workspace=workflow-events/lambdas/get-execution && npm run typecheck --workspace=workflow-events/lambdas/error-count-handler && npm run typecheck --workspace=budget-alert/lambdas/budget-handler && tsc --pretty false --noEmit -p scripts/jsconfig.broward-sunbiz.json && tsc --pretty false --noEmit -p scripts/jsconfig.broward-dashboard.json && tsc --pretty false --noEmit -p scripts/jsconfig.broward-recovery.json && tsc --pretty false --noEmit -p scripts/jsconfig.broward-accela.json && tsc --pretty false --noEmit -p scripts/jsconfig.broward-municipal-permits.json && tsc --pretty false --noEmit -p scripts/jsconfig.broward-permits.json",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "install-workspaces": "npm install --workspaces",
    "catalog:update": "node scripts/update-published-county-catalog.mjs",
    "dashboard:universal": "node scripts/serve-dashboard.mjs",
    "broward:sunbiz:prepare": "node scripts/prepare-broward-sunbiz-local.mjs",
    "broward:sunbiz:match-properties": "node scripts/match-broward-sunbiz-to-properties.mjs",
    "broward:dashboard": "node scripts/broward-ingestion-dashboard.mjs",
    "broward:dashboard:refresh-rollup": "node scripts/broward-dashboard-rollup.mjs",
    "broward:recover": "node scripts/recover-broward-appraisal-to-neon.mjs",
    "broward:recovery-dashboard": "node scripts/broward-neon-recovery-dashboard.mjs",
    "broward:tax-roll:profile": "node scripts/profile-broward-tax-roll.mjs",
    "broward:permits:pilot": "node scripts/run-broward-permit-pilot.mjs",
    "broward:permits:pilot-municipal": "node scripts/run-broward-municipal-permit-pilot.mjs",
    "broward:permits:capture-etrakit-session": "node scripts/run-broward-etrakit-session-capture.mjs",
    "broward:permits:load-pilot": "node scripts/load-broward-permit-pilot-to-neon.mjs",
    "broward:permits:run-supported": "node scripts/run-broward-supported-permit-ingest.mjs",
    "broward:permits:run-bulk": "node scripts/run-broward-bulk-permit-ingest.mjs",
    "broward:permits:load-list": "node scripts/load-broward-permit-list-to-neon.mjs",
    "broward:permits:run-accela-windows": "node scripts/run-broward-accela-date-windows.mjs",
    "broward:permits:run-accela-csv": "node scripts/run-broward-accela-csv-windows.mjs",
    "broward:permits:build-accela-property-seed": "node scripts/build-broward-accela-property-seed.mjs",
    "broward:permits:run-accela-gap-fill": "node scripts/run-broward-accela-property-gap-fill.mjs",
    "broward:permits:enqueue-accela-windows": "node scripts/enqueue-broward-accela-date-windows.mjs",
    "broward:permits:run-tyler-windows": "node scripts/run-broward-tyler-date-windows.mjs",
    "broward:permits:build-municipal-property-seed": "node scripts/build-broward-municipal-property-seed.mjs",
    "broward:permits:run-municipal-property": "node scripts/run-broward-municipal-property-enumeration.mjs",
    "broward:permits:run-municipal-types": "node scripts/run-broward-municipal-record-type-enumeration.mjs",
    "broward:permits:retry-tyler-source-missing": "node scripts/retry-broward-tyler-source-missing.mjs",
    "broward:bbb:roofing-worklist": "node scripts/build-broward-roofing-bbb-worklist.mjs",
    "query-post-logs": "node scripts/query_post_logs.js",
    "update-elephant-cli": "npm install @elephant-xyz/cli@latest --workspace=prepare/lambdas/downloader --workspace=workflow/lambdas/submit --workspace=workflow/lambdas/pre --workspace=workflow/lambdas/mvl",
    "hillsborough-pilot": "node scripts/hillsborough-local-pilot.mjs",
    "hillsborough-seed": "node scripts/hillsborough/build-full-seed.mjs",
    "hillsborough-status": "node scripts/hillsborough/status.mjs",
    "hillsborough-dashboard": "node scripts/hillsborough/serve-dashboard.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.895.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.895.0",
    "@aws-sdk/client-dynamodb": "^3.895.0",
    "@aws-sdk/client-eventbridge": "^3.879.0",
    "@aws-sdk/client-s3": "^3.879.0",
    "@aws-sdk/client-sfn": "^3.879.0",
    "@aws-sdk/lib-dynamodb": "^3.879.0",
    "@smithy/util-stream": "^4.2.0",
    "@types/node": "^20.16.3",
    "@vitest/coverage-v8": "^4.0.14",
    "aws-sdk-client-mock": "^4.1.0",
    "aws-sdk-client-mock-vitest": "^7.0.1",
    "chalk": "^4.1.2",
    "esbuild": "0.27.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vitest": "^4.0.14",
    "yargs": "^18.0.0"
  },
  "dependencies": {
    "@dsnp/parquetjs": "^1.8.7",
    "@esri/arcgis-to-geojson-utils": "^1.3.0",
    "cheerio": "^1.2.0",
    "commander": "^14.0.1",
    "duckdb": "^1.3.4",
    "events": "file:scripts/events-shim",
    "ipfs-only-hash": "^4.0.0",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.23.0",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "events": "file:scripts/events-shim"
  }
}
