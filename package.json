{
  "name": "oracle-node",
  "private": true,
  "workspaces": [
    "prepare/lambdas/*",
    "workflow/lambdas/*",
    "workflow-events/lambdas/*",
    "budget-alert/lambdas/*"
  ],
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "npm run typecheck --workspace=prepare/lambdas/downloader && npm run typecheck --workspace=prepare/lambdas/updater && npm run typecheck --workspace=workflow/lambdas/pre && npm run typecheck --workspace=workflow/lambdas/starter && npm run typecheck --workspace=workflow/lambdas/submit && npm run typecheck --workspace=workflow/lambdas/error-resolver && npm run typecheck --workspace=workflow/lambdas/permit-harvest-worker && npm run typecheck --workspace=workflow-events/lambdas/event-handler && npm run typecheck --workspace=workflow-events/lambdas/get-execution && npm run typecheck --workspace=workflow-events/lambdas/error-count-handler && npm run typecheck --workspace=budget-alert/lambdas/budget-handler",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "install-workspaces": "npm install --workspaces",
    "catalog:update": "node scripts/update-published-county-catalog.mjs",
    "catalog:mcp-maps": "node scripts/print-mcp-env-maps.mjs",
    "polk:appraisal:local": "node scripts/build-polk-local-appraisal.mjs",
    "polk:status": "node scripts/polk-local-status.mjs",
    "polk:dashboard": "node scripts/polk-local-dashboard.mjs",
    "polk:publication:prepare": "node scripts/prepare-polk-local-publication.mjs",
    "polk:permits:enrich": "node scripts/polk/permit-enrichment.mjs",
    "polk:sunbiz": "node scripts/polk/sunbiz-local.mjs",
    "polk:bbb": "node scripts/polk/bbb-contractor-crm.mjs",
    "polk:neon:reconcile": "node scripts/polk/neon-reconciliation.mjs",
    "polk:neon:stage": "node scripts/polk/query-db-stage.mjs",
    "polk:overture:publication": "node scripts/polk/overture-publication.mjs",
    "polk:overture:probe": "node scripts/extract-overture-places.mjs --county polk --county-name Polk --county-fips 12105 --release 2026-08-19.0 --boundary-source tiger/tl_2024_us_county --counts-only --output-dir tmp/polk/overture/2026-08-19.0/probe --cache-dir tmp/polk/overture/cache",
    "polk:overture:extract": "node scripts/extract-overture-places.mjs --county polk --county-name Polk --county-fips 12105 --release 2026-08-19.0 --boundary-source tiger/tl_2024_us_county --output-dir tmp/polk/overture/2026-08-19.0/extract --cache-dir tmp/polk/overture/cache",
    "query-post-logs": "node scripts/query_post_logs.js",
    "update-elephant-cli": "npm install @elephant-xyz/cli@latest --workspace=prepare/lambdas/downloader --workspace=workflow/lambdas/submit --workspace=workflow/lambdas/pre --workspace=workflow/lambdas/mvl",
    "hillsborough-pilot": "node scripts/hillsborough-local-pilot.mjs",
    "hillsborough-seed": "node scripts/hillsborough/build-full-seed.mjs",
    "hillsborough-status": "node scripts/hillsborough/status.mjs",
    "hillsborough-dashboard": "node scripts/hillsborough/serve-dashboard.mjs",
    "duval-seed": "node scripts/build-duval-seed.mjs",
    "duval-seed-sample": "node scripts/build-duval-validation-sample.mjs",
    "duval-pilot": "node scripts/duval-local-pilot.mjs",
    "duval-validate": "node scripts/validate-duval-appraisal.mjs",
    "duval-query-table": "node scripts/export-duval-query-table.mjs",
    "pinellas:permits": "node scripts/run-pinellas-permit-harvest.mjs"
  },
  "devDependencies": {
    "@aws-sdk/client-cloudformation": "^3.895.0",
    "@aws-sdk/client-cloudwatch-logs": "^3.895.0",
    "@aws-sdk/client-dynamodb": "^3.895.0",
    "@aws-sdk/client-eventbridge": "^3.879.0",
    "@aws-sdk/client-s3": "^3.879.0",
    "@aws-sdk/client-sfn": "^3.879.0",
    "@aws-sdk/lib-dynamodb": "^3.879.0",
    "@smithy/util-stream": "^4.2.0",
    "@types/node": "^20.16.3",
    "@vitest/coverage-v8": "^4.0.14",
    "aws-sdk-client-mock": "^4.1.0",
    "aws-sdk-client-mock-vitest": "^7.0.1",
    "chalk": "^4.1.2",
    "esbuild": "0.27.0",
    "prettier": "^3.3.3",
    "typescript": "^5.5.4",
    "vitest": "^4.0.14",
    "yargs": "^18.0.0"
  },
  "dependencies": {
    "@dsnp/parquetjs": "^1.8.7",
    "commander": "^14.0.1",
    "csv-parse": "^5.6.0",
    "duckdb": "^1.3.4",
    "events": "file:scripts/events-shim",
    "ipfs-only-hash": "^4.0.0",
    "pdfjs-dist": "^6.2.108",
    "pg": "^8.23.0"
  },
  "overrides": {
    "events": "file:scripts/events-shim"
  }
}
