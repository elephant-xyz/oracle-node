{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "strictNullChecks": true,
    "useUnknownInCatchVariables": true,
    "exactOptionalPropertyTypes": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "types": ["node"],
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "permit-source-adapters/bounded-permit-common.mjs",
    "permit-source-adapters/broward-permit-jurisdictions.mjs",
    "permit-source-adapters/citizenserve.mjs",
    "permit-source-adapters/tyler-civic-access.mjs",
    "probe-broward-municipal-permits.mjs"
  ]
}
