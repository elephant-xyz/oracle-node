{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "noImplicitAny": true,
    "noImplicitThis": true,
    "strictNullChecks": true,
    "useUnknownInCatchVariables": true,
    "exactOptionalPropertyTypes": false,
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "target": "ES2022",
    "types": ["node"],
    "skipLibCheck": true,
    "maxNodeModuleJsDepth": 0
  },
  "include": [
    "permit-source-adapters/bounded-permit-common.mjs",
    "permit-source-adapters/broward-permit-jurisdictions.mjs",
    "permit-source-adapters/citizenserve.mjs",
    "permit-source-adapters/tyler-civic-access.mjs",
    "run-broward-tyler-date-windows.mjs",
    "retry-broward-tyler-source-missing.mjs",
    "probe-broward-municipal-permits.mjs",
    "permit-source-adapters/broward-municipal-core.mjs",
    "permit-source-adapters/broward-municipal-config.mjs",
    "permit-source-adapters/broward-municipal-protocols.mjs",
    "permit-source-adapters/broward-municipal-transport.mjs",
    "run-broward-municipal-permit-pilot.mjs",
    "build-broward-municipal-property-seed.mjs",
    "run-broward-municipal-property-enumeration.mjs",
    "run-broward-municipal-record-type-enumeration.mjs"
  ]
}
