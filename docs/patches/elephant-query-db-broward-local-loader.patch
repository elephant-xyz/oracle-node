+ * @param artifactUri - URI emitted by the matching configured listing.
+ * @returns Complete ZIP bytes ready for the shared artifact mapper.
+ */
+function readConfiguredAppraisalArtifactBuffer(
+  options: BulkLoaderOptions,
+  s3: S3Client,
+  artifactUri: string,
+): Promise<Buffer> {
+  return options.appraisalLocalDir === null
+    ? readS3ObjectBuffer(s3, artifactUri)
+    : readLocalAppraisalArtifactBuffer(artifactUri);
+}
