+/**
+ * Collect a finite async iterable for deterministic assertions.
+ *
+ * @param source - Async values to collect.
+ * @returns Values in yielded order.
+ */
+async function collectAsync<Value>(
+  source: AsyncIterable<Value>,
+): Promise<readonly Value[]> {
+  const values: Value[] = [];
+  for await (const value of source) values.push(value);
+  return values;
+}
+
+/**
+ * Require one prepared row of a logical table.
+ *
+ * @param rows - Prepared mapper rows.
+ * @param tableName - Logical table to locate.
+ * @returns First matching prepared row.
+ */
+function findRow(
+  rows: readonly PreparedRow[],
+  tableName: LogicalTableName,
+): PreparedRow {
+  const row = rows.find((candidate) => candidate.tableName === tableName);
+  if (row === undefined) throw new Error(`Missing row for ${tableName}`);
+  return row;
+}
