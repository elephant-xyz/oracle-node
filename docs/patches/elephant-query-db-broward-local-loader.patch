+ */
+function listConfiguredAppraisalArtifacts(
+  options: BulkLoaderOptions,
+  s3: S3Client,
+): AsyncIterable<S3ObjectListing> {
+  if (options.appraisalLocalDir !== null) {
+    return listLocalAppraisalArtifacts({
+      rootDirectory: options.appraisalLocalDir,
+      limit: options.limit,
+    });
+  }
+  return listAppraisalArtifacts({
+    bucket: options.bucket,
+    limit: options.limit,
+    prefix: options.appraisalPrefix,
+    s3,
+  });
+}
+
+/**
+ * Read configured appraisal bytes from local disk or S3.
