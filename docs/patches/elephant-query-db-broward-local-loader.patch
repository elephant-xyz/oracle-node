+ *
+ * @param artifactPath - Destination ZIP path, including optional shard directories.
+ * @param folio - Exact numeric or alphanumeric Broward folio encoded in records.
+ */
+async function writeBrowardArtifact(
+  artifactPath: string,
+  folio: string,
+): Promise<void> {
+  await mkdir(dirname(artifactPath), { recursive: true });
+  const zip = new AdmZip();
+  const sourceHttpRequest = {
+    headers: { "content-type": "application/json" },
+    json: {
+      action: "CURRENT",
+      folioNumber: folio,
+      taxyear: "",
+      use: "",
+    },
+    method: "POST",
+    multiValueQueryString: {},
+    url: "https://web.bcpa.net/BcpaClient/search.aspx/getParcelInformation",
+  };
+  const withSource = (record: JsonObject): JsonObject => ({
+    source_http_request: sourceHttpRequest,
+    request_identifier: folio,
+    ...record,
+  });
+  const addJson = (entryName: string, record: JsonObject): void => {
+    zip.addFile(entryName, Buffer.from(JSON.stringify(record), "utf8"));
+  };
