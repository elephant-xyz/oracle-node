+    }),
+  );
+  addJson(
+    "data/mailing_address.json",
+    withSource({
+      unnormalized_address: "100 OWNER WAY, PLANTATION, FL 33324",
+    }),
+  );
+  addJson(
+    "data/geometry_parcel_0.json",
+    withSource({
+      latitude: 26.12,
+      longitude: -80.14,
+      polygon: [
+        { longitude: -80.15, latitude: 26.11 },
+        { longitude: -80.13, latitude: 26.11 },
+        { longitude: -80.13, latitude: 26.13 },
+        { longitude: -80.15, latitude: 26.11 },
+      ],
+    }),
+  );
+  addJson(
+    "data/tax_1.json",
+    withSource({
+      property_assessed_value_amount: 200000,
+      property_market_value_amount: 250000,
+      tax_year: 2025,
