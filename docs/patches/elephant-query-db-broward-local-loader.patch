+/**
+ * Enumerate transformed appraisal ZIPs from a local directory tree.
+ *
+ * The traversal keeps only canonical folio-named ZIP files such as
+ * `474131051910.zip`; prepare inputs such as
+ * `474131051910-prepared-input.zip` are deliberately excluded. Directory
+ * entries are sorted at each level, producing deterministic direct-file and
+ * sharded-directory order without materializing the full county inventory.
+ *
+ * @param params - Local root directory and optional maximum artifact count.
+ * @param params.rootDirectory - Direct-file or sharded transformed-artifact root.
+ * @param params.limit - Positive maximum number of artifacts, or `null` for all.
+ * @returns Async stream of canonical `file://` artifact URIs and byte sizes.
+ */
+export async function* listLocalAppraisalArtifacts(params: {
+  readonly rootDirectory: string;
+  readonly limit: number | null;
+}): AsyncGenerator<AppraisalArtifactListing> {
+  const rootDirectory = resolve(params.rootDirectory);
+  let yielded = 0;
+  for await (const artifactPath of walkLocalAppraisalArtifactPaths(rootDirectory)) {
+    if (params.limit !== null && yielded >= params.limit) return;
+    const artifactStat = await stat(artifactPath);
+    yield {
+      uri: pathToFileURL(artifactPath).href,
+      size: artifactStat.size,
+    };
+    yielded += 1;
+  }
+}
+
+/**
+ * Read one local appraisal ZIP into memory for immediate mapping.
+ *
+ * Callers process bounded artifact batches and release each returned buffer
+ * after mapping, so county-scale staging does not require a second artifact
+ * copy or an AWS client.
+ *
+ * @param artifactUri - Absolute path or canonical `file://` URI.
+ * @returns Complete ZIP bytes for `AdmZip`.
+ */
+export async function readLocalAppraisalArtifactBuffer(
+  artifactUri: string,
+): Promise<Buffer> {
+  const artifactPath = artifactUri.startsWith("file://")
+    ? fileURLToPath(artifactUri)
+    : resolve(artifactUri);
+  return readFile(artifactPath);
+}
+
+/**
+ * Map every JSON entity in one transformed appraisal ZIP.
+ *
+ * The artifact request identifier is derived before entity dispatch and passed
+ * to records such as `fact_sheet.json` that do not repeat it. Optional
+ * `data/source_payload.ndjson` provenance is retained by the existing appraisal
+ * mapper, while the ZIP URI is retained as `source_artifact_uri` on every
+ * prepared row.
+ *
+ * @param params - ZIP bytes, source identity, artifact URI, and jurisdiction metadata.
+ * @param params.artifactBuffer - Complete transformed ZIP bytes.
+ * @param params.artifactUri - Stable S3 or local file URI retained on mapped rows.
+ * @param params.countyName - County label written to parcel and address rows.
+ * @param params.sourceSystem - Appraiser source system and parcel jurisdiction key.
+ * @param params.stateCode - Two-letter state code written to parcel and address rows.
+ * @returns Parsed-record count, mapper rows, mapper skips, and derived request identifier.
+ */
+export function mapAppraisalArtifactZip(params: {
+  readonly artifactBuffer: Buffer;
+  readonly artifactUri: string;
+  readonly countyName: string | null;
+  readonly sourceSystem: string;
+  readonly stateCode: string | null;
+}): MappedAppraisalArtifact {
+  const zip = new AdmZip(params.artifactBuffer);
+  const sourcePayloadEntry = zip.getEntry(APPRAISAL_SOURCE_PAYLOAD_SIDECAR);
+  const artifactSourcePayload =
+    sourcePayloadEntry === null
+      ? undefined
+      : parseAppraisalSourcePayloadSidecar(
+          sourcePayloadEntry.getData().toString("utf8"),
+        );
+  const entries: readonly ParsedAppraisalEntry[] = zip
+    .getEntries()
+    .filter(
+      (entry) =>
+        entry.isDirectory === false && /^data\/.+\.json$/u.test(entry.entryName),
+    )
+    .sort((left, right) => left.entryName.localeCompare(right.entryName))
+    .map((entry) => ({
+      filePath: entry.entryName,
+      record: JSON.parse(entry.getData().toString("utf8")) as unknown,
+    }));
+  const requestIdentifier = deriveAppraisalArtifactRequestIdentifier(entries);
+  const rows: PreparedRow[] = [];
+  const skippedRecords: SkippedSourceRecord[] = [];
+
+  for (const entry of entries) {
+    const bundle = mapAppraisalTransformedFile({
+      artifactSourcePayload,
+      artifactUri: params.artifactUri,
+      countyName: params.countyName,
+      filePath: entry.filePath,
+      record: entry.record,
+      requestIdentifier,
+      sourceSystem: params.sourceSystem,
+      stateCode: params.stateCode,
+    });
+    rows.push(...bundle.rows);
+    skippedRecords.push(...bundle.skippedRecords);
+  }
+
+  return {
+    artifactUri: params.artifactUri,
+    inputRecords: entries.length,
+    requestIdentifier,
+    rows,
+    skippedRecords,
+  };
+}
+
+/**
+ * Reconcile the property and parcel identity emitted by one mapped artifact.
+ *
+ * The artifact filename is the expected Broward folio. Property and parcel
+ * folios come from `request_identifier`, preserving alphanumeric condominium
+ * identifiers that a digits-only matching projection would otherwise lose.
+ * Source metadata is considered retained only when the row has the configured
+ * artifact URI plus non-empty source-system, source-key, and source-hash fields.
+ *
+ * @param mapped - Complete mapped appraisal artifact.
+ * @returns Per-artifact property, parcel, folio, and provenance counters.
+ */
+export function reconcileMappedAppraisalArtifact(
+  mapped: MappedAppraisalArtifact,
+): AppraisalArtifactReconciliation {
+  const propertyRows = mapped.rows.filter((row) => row.tableName === "properties");
+  const parcelRows = mapped.rows.filter((row) => row.tableName === "parcels");
+  return {
+    artifactFolio: readAppraisalArtifactFolio(mapped.artifactUri),
+    parcelFolios: uniqueRequestIdentifiers(parcelRows),
+    parcelRows: parcelRows.length,
+    propertyFolios: uniqueRequestIdentifiers(propertyRows),
+    propertyRows: propertyRows.length,
+    rowsWithRetainedSourceMetadata: mapped.rows.filter(
+      (row) =>
+        row.values.source_artifact_uri === mapped.artifactUri &&
+        hasNonEmptyString(row.values.source_system) &&
+        hasNonEmptyString(row.values.source_record_key) &&
+        hasNonEmptyString(row.values.source_record_hash),
+    ).length,
+  };
+}
+
+/**
+ * Read the expected folio from a local or S3 artifact's leaf filename.
+ *
+ * @param artifactUri - Artifact URI ending in `<folio>.zip`.
+ * @returns Filename without the `.zip` extension.
+ * @throws Error when the URI does not identify a canonical folio ZIP.
+ */
+export function readAppraisalArtifactFolio(artifactUri: string): string {
+  const pathName = artifactUri.startsWith("file://")
+    ? fileURLToPath(artifactUri)
+    : new URL(artifactUri).pathname;
+  const fileName = basename(pathName);
+  if (!/^[A-Za-z0-9]+\.zip$/u.test(fileName)) {
+    throw new Error(`Appraisal artifact is not a canonical folio ZIP: ${artifactUri}`);
+  }
+  return fileName.slice(0, -".zip".length);
+}
+
+async function* walkLocalAppraisalArtifactPaths(
+  directory: string,
+): AsyncGenerator<string> {
+  const entries = (await readdir(directory, { withFileTypes: true })).sort(
+    (left, right) => left.name.localeCompare(right.name),
+  );
+  for (const entry of entries) {
+    const entryPath = resolve(directory, entry.name);
+    if (entry.isDirectory()) {
+      yield* walkLocalAppraisalArtifactPaths(entryPath);
+      continue;
+    }
+    if (entry.isFile() && /^[A-Za-z0-9]+\.zip$/u.test(entry.name)) {
+      yield entryPath;
+    }
+  }
+}
+
+function deriveAppraisalArtifactRequestIdentifier(
+  entries: readonly ParsedAppraisalEntry[],
+): string | null {
+  for (const preferredFileName of [
+    "data/property_seed.json",
+    "data/parcel.json",
+    "data/property.json",
+  ]) {
+    const entry = entries.find(
+      (candidate) => candidate.filePath === preferredFileName,
+    );
+    if (!isJsonObject(entry?.record)) continue;
+    const requestIdentifier = readString(entry.record.request_identifier);
+    if (requestIdentifier !== null) return requestIdentifier;
+  }
+  return null;
+}
+
+function uniqueRequestIdentifiers(
+  rows: readonly PreparedRow[],
+): readonly string[] {
+  return [
+    ...new Set(
+      rows.flatMap((row) => {
+        const requestIdentifier = readString(row.values.request_identifier);
+        return requestIdentifier === null ? [] : [requestIdentifier];
+      }),
+    ),
+  ].sort();
+}
+
+function hasNonEmptyString(value: unknown): value is string {
+  return typeof value === "string" && value.trim().length > 0;
+}
