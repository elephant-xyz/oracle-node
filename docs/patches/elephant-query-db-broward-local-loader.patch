diff --git a/src/loader/appraisal-local-stage.ts b/src/loader/appraisal-local-stage.ts
new file mode 100644
index 0000000000000000000000000000000000000000..e3e850f03e7e8520d9ade1ed5407ae4e189f09f9
--- /dev/null
+++ b/src/loader/appraisal-local-stage.ts
@@ -0,0 +1,675 @@
+import { createWriteStream } from "node:fs";
+import {
+  mkdir,
+  readFile,
+  rename,
+  rm,
+  writeFile,
+} from "node:fs/promises";
+import { dirname, resolve } from "node:path";
+import type { Writable } from "node:stream";
+
+import {
+  listLocalAppraisalArtifacts,
+  mapAppraisalArtifactZip,
+  readLocalAppraisalArtifactBuffer,
+  reconcileMappedAppraisalArtifact,
+  type AppraisalArtifactListing,
+} from "./appraisal-artifacts.js";
+import {
+  serializeBulkStageCsvHeader,
+  serializeBulkStageCsvRow,
+} from "./bulk.js";
+
+const LOCAL_APPRAISAL_STAGE_SCHEMA_VERSION = 1;
+
+export type LocalAppraisalStageOptions = {
+  readonly batchSize: number;
+  readonly checkpointFile: string;
+  readonly concurrency: number;
+  readonly countyName: string | null;
+  readonly limit: number | null;
+  readonly reportFile: string;
+  readonly rootDirectory: string;
+  readonly sourceSystem: string;
+  readonly stageDirectory: string;
+  readonly stateCode: string | null;
+};
+
+export type LocalAppraisalStageCounters = {
+  readonly artifactsDiscovered: number;
+  readonly artifactsMapped: number;
+  readonly artifactsSkippedFromCheckpoint: number;
+  readonly failedArtifacts: number;
+  readonly inputRecords: number;
+  readonly parcelRows: number;
+  readonly preparedRows: number;
+  readonly properties: number;
+  readonly rowsWithRetainedSourceMetadata: number;
+  readonly skippedRecords: number;
+  readonly stagedRows: number;
+};
+
+export type LocalAppraisalStageFailure = {
+  readonly artifactUri: string;
+  readonly error: string;
+};
+
+export type LocalAppraisalStageReport = {
+  readonly schemaVersion: number;
+  readonly mode: "local-appraisal-stage-dry-run";
+  readonly source: {
+    readonly countyName: string | null;
+    readonly jurisdictionKey: string;
+    readonly limit: number | null;
+    readonly localDirectory: string;
+    readonly stateCode: string | null;
+  };
+  readonly counters: LocalAppraisalStageCounters;
+  readonly reconciliation: {
+    readonly artifactFolios: number;
+    readonly distinctParcelFolios: number;
+    readonly distinctPropertyFolios: number;
+    readonly folioSetsMatch: boolean;
+    readonly oneParcelPerArtifact: boolean;
+    readonly onePropertyPerArtifact: boolean;
+    readonly propertiesMatchDistinctFolios: boolean;
+    readonly sourceMetadataRetainedForEveryRow: boolean;
+    readonly staleCheckpointArtifacts: number;
+  };
+  readonly failures: readonly LocalAppraisalStageFailure[];
+  readonly passed: boolean;
+};
+
+type MutableLocalAppraisalStageCounters = {
+  artifactsDiscovered: number;
+  artifactsMapped: number;
+  artifactsSkippedFromCheckpoint: number;
+  failedArtifacts: number;
+  inputRecords: number;
+  parcelRows: number;
+  preparedRows: number;
+  properties: number;
+  rowsWithRetainedSourceMetadata: number;
+  skippedRecords: number;
+  stagedRows: number;
+};
+
+type LocalAppraisalStageCheckpoint = {
+  readonly schemaVersion: number;
+  readonly sourceSignature: string;
+  readonly completedArtifactUris: readonly string[];
+  readonly artifactFolios: readonly string[];
+  readonly parcelFolios: readonly string[];
+  readonly propertyFolios: readonly string[];
+  readonly counters: Omit<
+    LocalAppraisalStageCounters,
+    | "artifactsDiscovered"
+    | "artifactsSkippedFromCheckpoint"
+    | "failedArtifacts"
+  >;
+};
+
+type MutableLocalAppraisalStageState = {
+  readonly completedArtifactUris: Set<string>;
+  readonly artifactFolios: Set<string>;
+  readonly parcelFolios: Set<string>;
+  readonly propertyFolios: Set<string>;
+  readonly counters: MutableLocalAppraisalStageCounters;
+};
+
+type MappedLocalArtifactResult = {
+  readonly artifactUri: string;
+  readonly artifactFolio: string;
+  readonly inputRecords: number;
+  readonly parcelFolios: readonly string[];
+  readonly parcelRows: number;
+  readonly preparedRows: number;
+  readonly propertyFolios: readonly string[];
+  readonly propertyRows: number;
+  readonly rowsWithRetainedSourceMetadata: number;
+  readonly skippedRecords: number;
+  readonly stagedRows: number;
+};
+
+/**
+ * Stage and reconcile local appraisal artifacts without AWS or PostgreSQL.
+ *
+ * Artifacts are enumerated deterministically, processed in bounded batches, and
+ * serialized through the production bulk-stage CSV encoder. Each batch CSV is
+ * removed after successful serialization, while a checkpoint persists completed
+ * artifact URIs and aggregate folio evidence. Re-running with the same source
+ * signature skips completed artifacts and retries only failed or interrupted
+ * work. The final report proves property, parcel, distinct-folio, and source
+ * metadata reconciliation without opening a database connection.
+ *
+ * @param options - Local source, jurisdiction, bounded-processing, and output paths.
+ * @returns Machine-readable reconciliation report also written to `reportFile`.
+ */
+export async function stageLocalAppraisalDryRun(
+  options: LocalAppraisalStageOptions,
+): Promise<LocalAppraisalStageReport> {
+  validateLocalAppraisalStageOptions(options);
+  const normalizedOptions = {
+    ...options,
+    checkpointFile: resolve(options.checkpointFile),
+    reportFile: resolve(options.reportFile),
+    rootDirectory: resolve(options.rootDirectory),
+    stageDirectory: resolve(options.stageDirectory),
+  };
+  const sourceSignature = buildLocalAppraisalSourceSignature(normalizedOptions);
+  const state = await readLocalAppraisalStageState(
+    normalizedOptions.checkpointFile,
+    sourceSignature,
+  );
+  const failures: LocalAppraisalStageFailure[] = [];
+  const pendingBatch: AppraisalArtifactListing[] = [];
+  const seenCompletedArtifactUris = new Set<string>();
+  let artifactsDiscovered = 0;
+  let artifactsSkippedFromCheckpoint = 0;
+
+  await mkdir(normalizedOptions.stageDirectory, { recursive: true });
+  await mkdir(dirname(normalizedOptions.checkpointFile), { recursive: true });
+  await mkdir(dirname(normalizedOptions.reportFile), { recursive: true });
+
+  const flushPendingBatch = async (): Promise<void> => {
+    if (pendingBatch.length === 0) return;
+    const batch = pendingBatch.splice(0, pendingBatch.length);
+    const batchFile = resolve(
+      normalizedOptions.stageDirectory,
+      "appraisal-local-dry-run-batch.csv",
+    );
+    const results = await stageLocalAppraisalBatch({
+      artifacts: batch,
+      batchFile,
+      concurrency: normalizedOptions.concurrency,
+      countyName: normalizedOptions.countyName,
+      failures,
+      sourceSystem: normalizedOptions.sourceSystem,
+      stateCode: normalizedOptions.stateCode,
+    });
+    for (const result of results) {
+      applyMappedArtifactResult(state, result);
+      seenCompletedArtifactUris.add(result.artifactUri);
+    }
+    await writeLocalAppraisalStageCheckpoint({
+      checkpointFile: normalizedOptions.checkpointFile,
+      sourceSignature,
+      state,
+    });
+    await rm(batchFile, { force: true });
+  };
+
+  for await (const artifact of listLocalAppraisalArtifacts({
+    rootDirectory: normalizedOptions.rootDirectory,
+    limit: normalizedOptions.limit,
+  })) {
+    artifactsDiscovered += 1;
+    if (state.completedArtifactUris.has(artifact.uri)) {
+      artifactsSkippedFromCheckpoint += 1;
+      seenCompletedArtifactUris.add(artifact.uri);
+      continue;
+    }
+    pendingBatch.push(artifact);
+    if (pendingBatch.length >= normalizedOptions.batchSize) {
+      await flushPendingBatch();
+    }
+  }
+  await flushPendingBatch();
+
+  const staleCheckpointArtifacts =
+    state.completedArtifactUris.size - seenCompletedArtifactUris.size;
+  const counters: LocalAppraisalStageCounters = {
+    ...state.counters,
+    artifactsDiscovered,
+    artifactsSkippedFromCheckpoint,
+    failedArtifacts: failures.length,
+  };
+  const folioSetsMatch = setsEqual(
+    state.artifactFolios,
+    state.propertyFolios,
+  ) && setsEqual(state.artifactFolios, state.parcelFolios);
+  const reconciliation = {
+    artifactFolios: state.artifactFolios.size,
+    distinctParcelFolios: state.parcelFolios.size,
+    distinctPropertyFolios: state.propertyFolios.size,
+    folioSetsMatch,
+    oneParcelPerArtifact:
+      state.counters.parcelRows === state.completedArtifactUris.size,
+    onePropertyPerArtifact:
+      state.counters.properties === state.completedArtifactUris.size,
+    propertiesMatchDistinctFolios:
+      state.counters.properties === state.propertyFolios.size,
+    sourceMetadataRetainedForEveryRow:
+      state.counters.rowsWithRetainedSourceMetadata ===
+      state.counters.preparedRows,
+    staleCheckpointArtifacts,
+  };
+  const passed =
+    artifactsDiscovered > 0 &&
+    failures.length === 0 &&
+    staleCheckpointArtifacts === 0 &&
+    state.completedArtifactUris.size === artifactsDiscovered &&
+    reconciliation.oneParcelPerArtifact &&
+    reconciliation.onePropertyPerArtifact &&
+    reconciliation.propertiesMatchDistinctFolios &&
+    reconciliation.sourceMetadataRetainedForEveryRow &&
+    reconciliation.folioSetsMatch;
+  const report: LocalAppraisalStageReport = {
+    schemaVersion: LOCAL_APPRAISAL_STAGE_SCHEMA_VERSION,
+    mode: "local-appraisal-stage-dry-run",
+    source: {
+      countyName: normalizedOptions.countyName,
+      jurisdictionKey: normalizedOptions.sourceSystem,
+      limit: normalizedOptions.limit,
+      localDirectory: normalizedOptions.rootDirectory,
+      stateCode: normalizedOptions.stateCode,
+    },
+    counters,
+    reconciliation,
+    failures,
+    passed,
+  };
+  await writeJsonAtomically(normalizedOptions.reportFile, report);
+  return report;
+}
+
+/**
+ * Stage one bounded batch through the production CSV serializer.
+ *
+ * @param params - Artifact batch, jurisdiction, concurrency, output file, and failure sink.
+ * @returns Successfully mapped per-artifact reconciliation results.
+ */
+async function stageLocalAppraisalBatch(params: {
+  readonly artifacts: readonly AppraisalArtifactListing[];
+  readonly batchFile: string;
+  readonly concurrency: number;
+  readonly countyName: string | null;
+  readonly failures: LocalAppraisalStageFailure[];
+  readonly sourceSystem: string;
+  readonly stateCode: string | null;
+}): Promise<readonly MappedLocalArtifactResult[]> {
+  const writer = createWriteStream(params.batchFile, {
+    encoding: "utf8",
+    flags: "w",
+  });
+  const results: MappedLocalArtifactResult[] = [];
+  let nextRowIndex = 1;
+  writer.write(serializeBulkStageCsvHeader());
+  try {
+    await processWithConcurrency(
+      params.artifacts,
+      params.concurrency,
+      async (artifact) => {
+        try {
+          const artifactBuffer =
+            await readLocalAppraisalArtifactBuffer(artifact.uri);
+          const mapped = mapAppraisalArtifactZip({
+            artifactBuffer,
+            artifactUri: artifact.uri,
+            countyName: params.countyName,
+            sourceSystem: params.sourceSystem,
+            stateCode: params.stateCode,
+          });
+          const reconciliation = reconcileMappedAppraisalArtifact(mapped);
+          let chunk = "";
+          for (const row of mapped.rows) {
+            chunk += serializeBulkStageCsvRow({
+              rowIndex: nextRowIndex,
+              row,
+            });
+            nextRowIndex += 1;
+          }
+          if (chunk.length > 0 && !writer.write(chunk)) {
+            await waitForDrain(writer);
+          }
+          results.push({
+            artifactUri: artifact.uri,
+            artifactFolio: reconciliation.artifactFolio,
+            inputRecords: mapped.inputRecords,
+            parcelFolios: reconciliation.parcelFolios,
+            parcelRows: reconciliation.parcelRows,
+            preparedRows: mapped.rows.length,
+            propertyFolios: reconciliation.propertyFolios,
+            propertyRows: reconciliation.propertyRows,
+            rowsWithRetainedSourceMetadata:
+              reconciliation.rowsWithRetainedSourceMetadata,
+            skippedRecords: mapped.skippedRecords.length,
+            stagedRows: mapped.rows.length,
+          });
+        } catch (caught) {
+          params.failures.push({
+            artifactUri: artifact.uri,
+            error: caught instanceof Error ? caught.message : String(caught),
+          });
+        }
+      },
+    );
+  } finally {
+    writer.end();
+    await waitForFinish(writer);
+  }
+  return results;
+}
+
+/**
+ * Apply one successful artifact result to resumable aggregate state.
+ *
+ * @param state - Mutable checkpoint-backed counters and identity sets.
+ * @param result - Successfully mapped artifact summary.
+ */
+function applyMappedArtifactResult(
+  state: MutableLocalAppraisalStageState,
+  result: MappedLocalArtifactResult,
+): void {
+  state.completedArtifactUris.add(result.artifactUri);
+  state.artifactFolios.add(result.artifactFolio);
+  for (const folio of result.parcelFolios) state.parcelFolios.add(folio);
+  for (const folio of result.propertyFolios) state.propertyFolios.add(folio);
+  state.counters.artifactsMapped += 1;
+  state.counters.inputRecords += result.inputRecords;
+  state.counters.parcelRows += result.parcelRows;
+  state.counters.preparedRows += result.preparedRows;
+  state.counters.properties += result.propertyRows;
+  state.counters.rowsWithRetainedSourceMetadata +=
+    result.rowsWithRetainedSourceMetadata;
+  state.counters.skippedRecords += result.skippedRecords;
+  state.counters.stagedRows += result.stagedRows;
+}
+
+/**
+ * Read a compatible checkpoint or initialize empty staging state.
+ *
+ * @param checkpointFile - JSON checkpoint path.
+ * @param sourceSignature - Exact source/configuration signature for safe resume.
+ * @returns Mutable state hydrated from the checkpoint when present.
+ */
+async function readLocalAppraisalStageState(
+  checkpointFile: string,
+  sourceSignature: string,
+): Promise<MutableLocalAppraisalStageState> {
+  try {
+    const parsed: unknown = JSON.parse(await readFile(checkpointFile, "utf8"));
+    if (!isLocalAppraisalStageCheckpoint(parsed)) {
+      throw new Error(`Invalid local appraisal checkpoint: ${checkpointFile}`);
+    }
+    if (parsed.sourceSignature !== sourceSignature) {
+      throw new Error(
+        `Local appraisal checkpoint source does not match this run: ${checkpointFile}`,
+      );
+    }
+    return {
+      completedArtifactUris: new Set(parsed.completedArtifactUris),
+      artifactFolios: new Set(parsed.artifactFolios),
+      parcelFolios: new Set(parsed.parcelFolios),
+      propertyFolios: new Set(parsed.propertyFolios),
+      counters: {
+        ...emptyMutableLocalAppraisalStageCounters(),
+        ...parsed.counters,
+      },
+    };
+  } catch (caught) {
+    if (isMissingFileError(caught)) {
+      return emptyLocalAppraisalStageState();
+    }
+    throw caught;
+  }
+}
+
+/**
+ * Persist resumable state atomically after a completed artifact batch.
+ *
+ * @param params - Checkpoint path, source signature, and aggregate state.
+ */
+async function writeLocalAppraisalStageCheckpoint(params: {
+  readonly checkpointFile: string;
+  readonly sourceSignature: string;
+  readonly state: MutableLocalAppraisalStageState;
+}): Promise<void> {
+  const checkpoint: LocalAppraisalStageCheckpoint = {
+    schemaVersion: LOCAL_APPRAISAL_STAGE_SCHEMA_VERSION,
+    sourceSignature: params.sourceSignature,
+    completedArtifactUris: [...params.state.completedArtifactUris].sort(),
+    artifactFolios: [...params.state.artifactFolios].sort(),
+    parcelFolios: [...params.state.parcelFolios].sort(),
+    propertyFolios: [...params.state.propertyFolios].sort(),
+    counters: {
+      artifactsMapped: params.state.counters.artifactsMapped,
+      inputRecords: params.state.counters.inputRecords,
+      parcelRows: params.state.counters.parcelRows,
+      preparedRows: params.state.counters.preparedRows,
+      properties: params.state.counters.properties,
+      rowsWithRetainedSourceMetadata:
+        params.state.counters.rowsWithRetainedSourceMetadata,
+      skippedRecords: params.state.counters.skippedRecords,
+      stagedRows: params.state.counters.stagedRows,
+    },
+  };
+  await writeJsonAtomically(params.checkpointFile, checkpoint);
+}
+
+/**
+ * Build the immutable signature that prevents unsafe cross-run checkpoint reuse.
+ *
+ * @param options - Normalized local source and mapping configuration.
+ * @returns Stable JSON signature string.
+ */
+function buildLocalAppraisalSourceSignature(
+  options: LocalAppraisalStageOptions,
+): string {
+  return JSON.stringify({
+    schemaVersion: LOCAL_APPRAISAL_STAGE_SCHEMA_VERSION,
+    rootDirectory: resolve(options.rootDirectory),
+    sourceSystem: options.sourceSystem,
+    countyName: options.countyName,
+    stateCode: options.stateCode,
+    limit: options.limit,
+  });
+}
+
+/**
+ * Validate bounded local staging parameters before touching output files.
+ *
+ * @param options - Caller-supplied local stage options.
+ * @throws Error for non-positive batch/concurrency values or empty paths.
+ */
+function validateLocalAppraisalStageOptions(
+  options: LocalAppraisalStageOptions,
+): void {
+  if (!Number.isInteger(options.batchSize) || options.batchSize <= 0) {
+    throw new Error("Local appraisal dry-run batchSize must be a positive integer");
+  }
+  if (!Number.isInteger(options.concurrency) || options.concurrency <= 0) {
+    throw new Error("Local appraisal dry-run concurrency must be a positive integer");
+  }
+  for (const [name, value] of [
+    ["rootDirectory", options.rootDirectory],
+    ["stageDirectory", options.stageDirectory],
+    ["checkpointFile", options.checkpointFile],
+    ["reportFile", options.reportFile],
+    ["sourceSystem", options.sourceSystem],
+  ] as const) {
+    if (value.trim().length === 0) {
+      throw new Error(`Local appraisal dry-run ${name} must not be empty`);
+    }
+  }
+}
+
+/**
+ * Compare two string sets by exact membership.
+ *
+ * @param left - First identity set.
+ * @param right - Second identity set.
+ * @returns True when both sets contain exactly the same values.
+ */
+function setsEqual(left: ReadonlySet<string>, right: ReadonlySet<string>): boolean {
+  if (left.size !== right.size) return false;
+  for (const value of left) {
+    if (!right.has(value)) return false;
+  }
+  return true;
+}
+
+/**
+ * Write JSON through a sibling temporary file and atomic rename.
+ *
+ * @param path - Final JSON output path.
+ * @param value - JSON-serializable checkpoint or report value.
+ */
+async function writeJsonAtomically(path: string, value: unknown): Promise<void> {
+  const temporaryPath = `${path}.tmp`;
+  await writeFile(temporaryPath, `${JSON.stringify(value, null, 2)}\n`, "utf8");
+  await rename(temporaryPath, path);
+}
+
+/**
+ * Run item handlers with a fixed upper concurrency bound.
+ *
+ * @param items - In-memory bounded artifact batch.
+ * @param concurrency - Maximum simultaneously running handlers.
+ * @param handler - Async artifact handler.
+ */
+async function processWithConcurrency<Item>(
+  items: readonly Item[],
+  concurrency: number,
+  handler: (item: Item) => Promise<void>,
+): Promise<void> {
+  const running = new Set<Promise<void>>();
+  for (const item of items) {
+    const task = handler(item).finally(() => {
+      running.delete(task);
+    });
+    running.add(task);
+    if (running.size >= concurrency) await Promise.race(running);
+  }
+  await Promise.all(running);
+}
+
+/**
+ * Wait until a backpressured writable stream accepts more data.
+ *
+ * @param writer - Active stage CSV stream.
+ */
+function waitForDrain(writer: Writable): Promise<void> {
+  return new Promise((resolvePromise, rejectPromise) => {
+    writer.once("drain", resolvePromise);
+    writer.once("error", rejectPromise);
+  });
+}
+
+/**
+ * Wait until a writable stream has flushed and closed.
+ *
+ * @param writer - Stage CSV stream after `end()`.
+ */
+function waitForFinish(writer: Writable): Promise<void> {
+  return new Promise((resolvePromise, rejectPromise) => {
+    writer.once("finish", resolvePromise);
+    writer.once("error", rejectPromise);
+  });
+}
+
+/**
+ * Construct empty mutable local-stage state.
+ *
+ * @returns New identity sets and zero-filled cumulative counters.
+ */
+function emptyLocalAppraisalStageState(): MutableLocalAppraisalStageState {
+  return {
+    completedArtifactUris: new Set(),
+    artifactFolios: new Set(),
+    parcelFolios: new Set(),
+    propertyFolios: new Set(),
+    counters: emptyMutableLocalAppraisalStageCounters(),
+  };
+}
+
+/**
+ * Construct zero-filled local-stage counters.
+ *
+ * @returns Mutable counters for current and cumulative staging evidence.
+ */
+function emptyMutableLocalAppraisalStageCounters(): MutableLocalAppraisalStageCounters {
+  return {
+    artifactsDiscovered: 0,
+    artifactsMapped: 0,
+    artifactsSkippedFromCheckpoint: 0,
+    failedArtifacts: 0,
+    inputRecords: 0,
+    parcelRows: 0,
+    preparedRows: 0,
+    properties: 0,
+    rowsWithRetainedSourceMetadata: 0,
+    skippedRecords: 0,
+    stagedRows: 0,
+  };
+}
+
+/**
+ * Validate persisted checkpoint structure without weakening strict types.
+ *
+ * @param value - Parsed unknown JSON value.
+ * @returns Whether the value has the complete checkpoint shape.
+ */
+function isLocalAppraisalStageCheckpoint(
+  value: unknown,
+): value is LocalAppraisalStageCheckpoint {
+  if (typeof value !== "object" || value === null) return false;
+  const candidate = value as Record<string, unknown>;
+  return (
+    candidate.schemaVersion === LOCAL_APPRAISAL_STAGE_SCHEMA_VERSION &&
+    typeof candidate.sourceSignature === "string" &&
+    isStringArray(candidate.completedArtifactUris) &&
+    isStringArray(candidate.artifactFolios) &&
+    isStringArray(candidate.parcelFolios) &&
+    isStringArray(candidate.propertyFolios) &&
+    isCheckpointCounters(candidate.counters)
+  );
+}
+
+/**
+ * Validate checkpoint cumulative counter fields.
+ *
+ * @param value - Unknown checkpoint `counters` member.
+ * @returns Whether every required cumulative counter is a finite number.
+ */
+function isCheckpointCounters(
+  value: unknown,
+): value is LocalAppraisalStageCheckpoint["counters"] {
+  if (typeof value !== "object" || value === null) return false;
+  const candidate = value as Record<string, unknown>;
+  return [
+    "artifactsMapped",
+    "inputRecords",
+    "parcelRows",
+    "preparedRows",
+    "properties",
+    "rowsWithRetainedSourceMetadata",
+    "skippedRecords",
+    "stagedRows",
+  ].every((key) => typeof candidate[key] === "number");
+}
+
+/**
+ * Validate an unknown value as an array of strings.
+ *
+ * @param value - Unknown parsed checkpoint member.
+ * @returns Whether the value is a string-only array.
+ */
+function isStringArray(value: unknown): value is readonly string[] {
+  return Array.isArray(value) && value.every((item) => typeof item === "string");
+}
+
+/**
+ * Identify a filesystem missing-file error.
+ *
+ * @param value - Unknown error thrown while reading a checkpoint.
+ * @returns Whether Node reported `ENOENT`.
+ */
+function isMissingFileError(value: unknown): value is NodeJS.ErrnoException {
+  return (
+    value instanceof Error &&
+    "code" in value &&
+    value.code === "ENOENT"
+  );
+}
