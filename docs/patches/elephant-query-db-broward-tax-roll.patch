--- /dev/null
+++ b/src/loader/florida-nal.ts
@@ -0,0 +1,812 @@
+import {
+  buildNormalizedAddressKey,
+  buildSourceMetadata,
+  compactObject,
+  hashNormalizedAddressKey,
+  normalizePostalCode,
+  readInteger,
+  readNumber,
+  readString,
+} from "./normalizers.js";
+import type {
+  JsonObject,
+  PreparedRow,
+  PreparedRowBundle,
+  SourceSystem,
+} from "./types.js";
+
+export const FLORIDA_DOR_NAL_SOURCE_SYSTEM = "florida_dor_nal" as const;
+export const BROWARD_DOR_COUNTY_NUMBER = "16";
+
+export type FloridaNalCertificationStatus =
+  | "preliminary"
+  | "initial_final"
+  | "final_certified";
+
+export type FloridaNalRawRow = Readonly<Record<string, string | undefined>>;
+
+export type FloridaNalContext = {
+  readonly countyName: string;
+  readonly countyNumber: string;
+  readonly stateCode: string;
+  readonly jurisdictionKey: string;
+  readonly rollYear: number;
+  readonly certificationStatus: FloridaNalCertificationStatus;
+  readonly retrievedAt: string;
+  readonly sourceArtifactUri: string;
+  readonly sourceSha256: string;
+  readonly existingPropertySourceRecordKey: string | null;
+};
+
+export type FloridaNalPropertyClassification = {
+  readonly build_status: "Improved" | "VacantLand";
+  readonly ownership_estate_type:
+    | "Condominium"
+    | "Cooperative"
+    | "FeeSimple"
+    | "Leasehold"
+    | "RightOfWay"
+    | "SubsurfaceRights";
+  readonly property_type:
+    | "Building"
+    | "LandParcel"
+    | "ManufacturedHome"
+    | "Unit";
+  readonly property_usage_type: string;
+  readonly structure_form: string | null;
+};
+
+export type FloridaNalMappingResult = PreparedRowBundle & {
+  readonly parcelId: string;
+  readonly dorUseCode: string;
+  readonly isCondominium: boolean;
+  readonly createdCanonicalProperty: boolean;
+  readonly exemptionCount: number;
+  readonly saleCount: number;
+};
+
+const PARCEL_ID_PATTERN = /^[0-9A-Z]{12}$/;
+const SHA256_PATTERN = /^[a-f0-9]{64}$/;
+const EXEMPTION_FIELD_PATTERN = /^EXMPT_(?:0[1-9]|[1-4][0-9]|46|8[0-2])$/;
+
+/**
+ * Map one official Florida DOR NAL real-property row into query-db logical rows.
+ *
+ * Existing county-appraiser properties remain canonical. The caller supplies
+ * their exact source key after a database lookup. When no appraiser property
+ * exists, the mapper creates one DOR-backed parcel/property stub so tax-roll-
+ * only units remain queryable without inventing geometry.
+ *
+ * @param row - One parsed NAL CSV row with all values retained as strings.
+ * @param context - Verified source provenance and canonical-property decision.
+ * @returns Prepared logical rows with exact source keys and raw NAL preservation.
+ */
+export function mapFloridaNalRow(
+  row: FloridaNalRawRow,
+  context: FloridaNalContext,
+): FloridaNalMappingResult {
+  const parcelId = requireFloridaNalParcelId(row.PARCEL_ID);
+  const rowYear = requireInteger(row.ASMNT_YR, "ASMNT_YR");
+  if (row.CO_NO?.trim() !== context.countyNumber) {
+    throw new Error("NAL county number does not match the configured county");
+  }
+  if (row.FILE_T?.trim() !== "R") {
+    throw new Error("NAL row is not a real-property record");
+  }
+  if (rowYear !== context.rollYear) {
+    throw new Error("NAL assessment year does not match source metadata");
+  }
+  if (!SHA256_PATTERN.test(context.sourceSha256)) {
+    throw new Error("NAL source checksum must be a lowercase SHA-256");
+  }
+  const retrievedAt = new Date(context.retrievedAt);
+  if (!Number.isFinite(retrievedAt.getTime())) {
+    throw new Error("NAL retrieval timestamp must be an ISO timestamp");
+  }
+
+  const dorUseCode = requireDorUseCode(row.DOR_UC);
+  const classification = classifyFloridaDorUseCode(dorUseCode, row);
+  const sourcePayload: JsonObject = {
+    ...row,
+    certification_status: context.certificationStatus,
+    retrieved_at: retrievedAt.toISOString(),
+    source_sha256: context.sourceSha256,
+  };
+  const propertySourceRecordKey =
+    context.existingPropertySourceRecordKey ??
+    sourceKey(parcelId, "property", "property");
+  const taxSourceRecordKey = sourceKey(
+    parcelId,
+    "tax",
+    String(context.rollYear),
+  );
+  const siteAddressSourceRecordKey = sourceKey(parcelId, "address", "site");
+  const mailingAddressSourceRecordKey = sourceKey(
+    parcelId,
+    "address",
+    "owner-mailing",
+  );
+
+  const rows: PreparedRow[] = [
+    mapAddressRow({
+      parcelId,
+      role: "site",
+      addressLine1: row.PHY_ADDR1,
+      addressLine2: row.PHY_ADDR2,
+      city: row.PHY_CITY,
+      state: context.stateCode,
+      postalCode: row.PHY_ZIPCD,
+      countyName: context.countyName,
+      township: row.TWN,
+      range: row.RNG,
+      section: row.SEC,
+      sourceArtifactUri: context.sourceArtifactUri,
+      sourceRecordKey: siteAddressSourceRecordKey,
+    }),
+    mapAddressRow({
+      parcelId,
+      role: "owner-mailing",
+      addressLine1: row.OWN_ADDR1,
+      addressLine2: row.OWN_ADDR2,
+      city: row.OWN_CITY,
+      state: row.OWN_STATE,
+      postalCode: row.OWN_ZIPCD,
+      countyName: null,
+      township: null,
+      range: null,
+      section: null,
+      sourceArtifactUri: context.sourceArtifactUri,
+      sourceRecordKey: mailingAddressSourceRecordKey,
+    }),
+  ];
+
+  if (context.existingPropertySourceRecordKey === null) {
+    const parcelSourceRecordKey = sourceKey(parcelId, "parcel", "parcel");
+    rows.push(
+      {
+        tableName: "parcels",
+        values: compactObject({
+          ...metadata(
+            parcelSourceRecordKey,
+            {
+              parcel_id: parcelId,
+              county_number: context.countyNumber,
+              roll_year: context.rollYear,
+            },
+            context.sourceArtifactUri,
+          ),
+          request_identifier: parcelId,
+          parcel_identifier: parcelId,
+          county_name: context.countyName,
+          state_code: context.stateCode,
+          jurisdiction_key: context.jurisdictionKey,
+          source_payload: {
+            parcel_id: parcelId,
+            county_number: context.countyNumber,
+            roll_year: context.rollYear,
+          },
+        }),
+      },
+      {
+        tableName: "properties",
+        references: {
+          addressSourceRecordKey: siteAddressSourceRecordKey,
+          parcelSourceRecordKey,
+        },
+        values: compactObject({
+          ...metadata(
+            propertySourceRecordKey,
+            {
+              parcel_id: parcelId,
+              classification,
+              roll_year: context.rollYear,
+            },
+            context.sourceArtifactUri,
+          ),
+          request_identifier: parcelId,
+          parcel_identifier: parcelId,
+          ...classification,
+          property_legal_description_text: readString(row.S_LEGAL),
+          property_structure_built_year: readInteger(row.ACT_YR_BLT),
+          property_effective_built_year: readInteger(row.EFF_YR_BLT),
+          livable_floor_area: readString(row.TOT_LVG_AREA),
+          total_area: readString(row.LND_SQFOOT),
+          number_of_units: readInteger(row.NO_RES_UNTS),
+          number_of_units_type:
+            readInteger(row.NO_RES_UNTS) === null ? undefined : "Residential",
+          source_payload: {
+            parcel_id: parcelId,
+            dor_use_code: dorUseCode,
+            pa_use_code: readString(row.PA_UC),
+            roll_year: context.rollYear,
+            certification_status: context.certificationStatus,
+          },
+        }),
+      },
+    );
+  }
+
+  rows.push(
+    mapOwnershipRow({
+      row,
+      parcelId,
+      propertySourceRecordKey,
+      mailingAddressSourceRecordKey,
+      context,
+    }),
+    mapTaxRow({
+      row,
+      parcelId,
+      propertySourceRecordKey,
+      taxSourceRecordKey,
+      sourcePayload,
+      context,
+    }),
+    mapValuationRow({
+      row,
+      parcelId,
+      propertySourceRecordKey,
+      sourcePayload,
+      context,
+    }),
+  );
+
+  const authority = mapTaxAuthorityRow({
+    row,
+    parcelId,
+    propertySourceRecordKey,
+    taxSourceRecordKey,
+    context,
+  });
+  if (authority !== null) rows.push(authority);
+
+  const exemptionRows = mapTaxExemptionRows({
+    row,
+    parcelId,
+    taxSourceRecordKey,
+    context,
+  });
+  rows.push(...exemptionRows);
+
+  const saleRows = [1, 2].flatMap((slot) => {
+    const sale = mapSaleRow({
+      row,
+      slot,
+      parcelId,
+      propertySourceRecordKey,
+      context,
+    });
+    return sale === null ? [] : [sale];
+  });
+  rows.push(...saleRows);
+
+  return {
+    parcelId,
+    dorUseCode,
+    isCondominium: dorUseCode === "004",
+    createdCanonicalProperty: context.existingPropertySourceRecordKey === null,
+    exemptionCount: exemptionRows.length,
+    saleCount: saleRows.length,
+    rows,
+    skippedRecords: [],
+  };
+}
+
+/**
+ * Require Broward's exact undashed folio form without numeric coercion.
+ *
+ * @param value - Raw NAL parcel identifier.
+ * @returns Canonical 12-character uppercase alphanumeric folio.
+ */
+export function requireFloridaNalParcelId(value: unknown): string {
+  const parcelId = readString(value)?.toUpperCase();
+  if (parcelId === undefined || parcelId === null) {
+    throw new Error("NAL parcel identifier is missing");
+  }
+  if (!PARCEL_ID_PATTERN.test(parcelId)) {
+    throw new Error("NAL parcel identifier is malformed");
+  }
+  return parcelId;
+}
+
+/**
+ * Map a DOR predominant-use code to existing County Lexicon fields.
+ *
+ * The mapping intentionally stays at a defensible DOR category level. Local
+ * PA subcodes remain in the raw source payload rather than being guessed.
+ *
+ * @param dorUseCode - Three-digit DOR use code.
+ * @param row - Source row used only for explicit building/unit signals.
+ * @returns Existing Lexicon-compatible property classification.
+ */
+export function classifyFloridaDorUseCode(
+  dorUseCode: string,
+  row: FloridaNalRawRow,
+): FloridaNalPropertyClassification {
+  const code = Number(dorUseCode);
+  const explicitlyVacant = new Set([0, 10, 40, 70, 99]).has(code);
+  const buildingCount = readInteger(row.NO_BULDNG) ?? 0;
+  const livingArea = readNumber(row.TOT_LVG_AREA) ?? 0;
+  const buildStatus =
+    explicitlyVacant && buildingCount === 0 && livingArea === 0
+      ? "VacantLand"
+      : "Improved";
+
+  if (code === 2) {
+    return {
+      build_status: buildStatus,
+      ownership_estate_type: "FeeSimple",
+      property_type: "ManufacturedHome",
+      property_usage_type: "Residential",
+      structure_form: "ManufacturedHousing",
+    };
+  }
+  if (code === 4 || code === 5) {
+    return {
+      build_status: buildStatus,
+      ownership_estate_type: code === 4 ? "Condominium" : "Cooperative",
+      property_type: "Unit",
+      property_usage_type: "Residential",
+      structure_form: "ApartmentUnit",
+    };
+  }
+  if (code === 9) {
+    return genericClassification(
+      buildStatus,
+      "ResidentialCommonElementsAreas",
+      "LandParcel",
+    );
+  }
+  if (code >= 0 && code <= 8) {
+    return genericClassification(
+      buildStatus,
+      "Residential",
+      buildStatus === "VacantLand" ? "LandParcel" : "Building",
+    );
+  }
+  if (code >= 10 && code <= 39) {
+    return genericClassification(
+      buildStatus,
+      "Commercial",
+      buildStatus === "VacantLand" ? "LandParcel" : "Building",
+    );
+  }
+  if (code >= 40 && code <= 49) {
+    return genericClassification(
+      buildStatus,
+      "Industrial",
+      buildStatus === "VacantLand" ? "LandParcel" : "Building",
+    );
+  }
+  if (code >= 50 && code <= 69) {
+    return genericClassification(
+      buildStatus,
+      "Agricultural",
+      buildStatus === "VacantLand" ? "LandParcel" : "Building",
+    );
+  }
+
+  const institutionalUsage = new Map<number, string>([
+    [71, "Church"],
+    [72, "PrivateSchool"],
+    [73, "PrivateHospital"],
+    [74, "HomesForAged"],
+    [75, "NonProfitCharity"],
+    [76, "MortuaryCemetery"],
+    [77, "ClubsLodges"],
+    [78, "SanitariumConvalescentHome"],
+    [79, "CulturalOrganization"],
+    [80, "GovernmentProperty"],
+    [81, "Military"],
+    [82, "ForestParkRecreation"],
+    [83, "PublicSchool"],
+    [84, "PublicSchool"],
+    [85, "PublicHospital"],
+    [86, "GovernmentProperty"],
+    [87, "GovernmentProperty"],
+    [88, "GovernmentProperty"],
+    [89, "GovernmentProperty"],
+    [91, "Utility"],
+    [92, "MineralProcessing"],
+    [95, "RiversLakes"],
+    [96, "SewageDisposal"],
+    [97, "Recreational"],
+    [98, "Utility"],
+  ]);
+  const estateType =
+    code === 90
+      ? "Leasehold"
+      : code === 93
+        ? "SubsurfaceRights"
+        : code === 94
+          ? "RightOfWay"
+          : "FeeSimple";
+  return {
+    ...genericClassification(
+      buildStatus,
+      institutionalUsage.get(code) ?? "Commercial",
+      buildStatus === "VacantLand" ? "LandParcel" : "Building",
+    ),
+    ownership_estate_type: estateType,
+  };
+}
+
+function genericClassification(
+  buildStatus: "Improved" | "VacantLand",
+  usageType: string,
+  propertyType: "Building" | "LandParcel",
+): FloridaNalPropertyClassification {
+  return {
+    build_status: buildStatus,
+    ownership_estate_type: "FeeSimple",
+    property_type: propertyType,
+    property_usage_type: usageType,
+    structure_form: null,
+  };
+}
+
+function mapAddressRow(params: {
+  readonly parcelId: string;
+  readonly role: "site" | "owner-mailing";
+  readonly addressLine1: string | undefined;
+  readonly addressLine2: string | undefined;
+  readonly city: string | undefined;
+  readonly state: string | undefined;
+  readonly postalCode: string | undefined;
+  readonly countyName: string | null;
+  readonly township: string | null | undefined;
+  readonly range: string | null | undefined;
+  readonly section: string | null | undefined;
+  readonly sourceArtifactUri: string;
+  readonly sourceRecordKey: string;
+}): PreparedRow {
+  const parts = [
+    readString(params.addressLine1),
+    readString(params.addressLine2),
+    readString(params.city),
+    readString(params.state),
+    normalizePostalCode(params.postalCode),
+  ].filter((value): value is string => value !== null);
+  const unnormalizedAddress = parts.join(", ");
+  const normalizedAddressKey = buildNormalizedAddressKey(unnormalizedAddress);
+  const state = readString(params.state);
+  const payload = {
+    role: params.role,
+    address_line_1: readString(params.addressLine1),
+    address_line_2: readString(params.addressLine2),
+    city: readString(params.city),
+    state,
+    postal_code: normalizePostalCode(params.postalCode),
+  };
+  return {
+    tableName: "addresses",
+    values: compactObject({
+      ...metadata(
+        params.sourceRecordKey,
+        payload,
+        params.sourceArtifactUri,
+      ),
+      request_identifier: params.parcelId,
+      city_name: readString(params.city),
+      municipality_name: params.role === "site" ? readString(params.city) : null,
+      county_name: params.countyName,
+      state_code: state?.length === 2 ? state.toUpperCase() : null,
+      postal_code: normalizePostalCode(params.postalCode),
+      country_code:
+        normalizePostalCode(params.postalCode) === null ? null : "US",
+      township: readString(params.township),
+      range: readString(params.range),
+      section: readString(params.section),
+      unnormalized_address:
+        unnormalizedAddress.length === 0 ? null : unnormalizedAddress,
+      normalized_address_key: normalizedAddressKey,
+      normalized_address_hash:
+        hashNormalizedAddressKey(normalizedAddressKey),
+      source_payload: payload,
+    }),
+  };
+}
+
+function mapOwnershipRow(params: {
+  readonly row: FloridaNalRawRow;
+  readonly parcelId: string;
+  readonly propertySourceRecordKey: string;
+  readonly mailingAddressSourceRecordKey: string;
+  readonly context: FloridaNalContext;
+}): PreparedRow {
+  const payload = {
+    owner_name: readString(params.row.OWN_NAME),
+    owner_state_of_domicile: readString(params.row.OWN_STATE_DOM),
+    roll_year: params.context.rollYear,
+    certification_status: params.context.certificationStatus,
+  };
+  return {
+    tableName: "ownerships",
+    references: {
+      mailingAddressSourceRecordKey: params.mailingAddressSourceRecordKey,
+      propertySourceRecordKey: params.propertySourceRecordKey,
+    },
+    values: compactObject({
+      ...metadata(
+        sourceKey(
+          params.parcelId,
+          "ownership",
+          String(params.context.rollYear),
+        ),
+        payload,
+        params.context.sourceArtifactUri,
+      ),
+      ownership_identifier: `DOR-NAL-${String(params.context.rollYear)}`,
+      owned_by: readString(params.row.OWN_NAME),
+      source_payload: payload,
+    }),
+  };
+}
+
+function mapTaxRow(params: {
+  readonly row: FloridaNalRawRow;
+  readonly parcelId: string;
+  readonly propertySourceRecordKey: string;
+  readonly taxSourceRecordKey: string;
+  readonly sourcePayload: JsonObject;
+  readonly context: FloridaNalContext;
+}): PreparedRow {
+  const justValue = readNumber(params.row.JV);
+  const landValue = readNumber(params.row.LND_VAL);
+  const buildingValue =
+    justValue === null || landValue === null
+      ? null
+      : Math.max(0, justValue - landValue);
+  return {
+    tableName: "taxes",
+    references: {
+      propertySourceRecordKey: params.propertySourceRecordKey,
+    },
+    values: compactObject({
+      ...metadata(
+        params.taxSourceRecordKey,
+        params.sourcePayload,
+        params.context.sourceArtifactUri,
+      ),
+      request_identifier: params.parcelId,
+      tax_year: params.context.rollYear,
+      property_market_value_amount: justValue,
+      property_assessed_value_amount: readNumber(params.row.AV_NSD),
+      property_building_amount: buildingValue,
+      property_land_amount: landValue,
+      property_taxable_value_amount: readNumber(params.row.TV_NSD),
+      county_taxable_value_amount: readNumber(params.row.TV_NSD),
+      school_taxable_value_amount: readNumber(params.row.TV_SD),
+      agricultural_valuation_amount: readNumber(params.row.AV_CLASS_USE),
+      homestead_cap_loss_amount: nonnegativeDifference(
+        params.row.JV_HMSTD,
+        params.row.AV_HMSTD,
+      ),
+      period_start_date: `${String(params.context.rollYear)}-01-01`,
+      period_end_date: `${String(params.context.rollYear)}-12-31`,
+      source_payload: params.sourcePayload,
+    }),
+  };
+}
+
+function mapValuationRow(params: {
+  readonly row: FloridaNalRawRow;
+  readonly parcelId: string;
+  readonly propertySourceRecordKey: string;
+  readonly sourcePayload: JsonObject;
+  readonly context: FloridaNalContext;
+}): PreparedRow {
+  const payload = {
+    certification_status: params.context.certificationStatus,
+    dor_use_code: readString(params.row.DOR_UC),
+    roll_year: params.context.rollYear,
+    source_sha256: params.context.sourceSha256,
+  };
+  return {
+    tableName: "property_valuations",
+    references: {
+      propertySourceRecordKey: params.propertySourceRecordKey,
+    },
+    values: compactObject({
+      ...metadata(
+        sourceKey(
+          params.parcelId,
+          "property_valuation",
+          String(params.context.rollYear),
+        ),
+        payload,
+        params.context.sourceArtifactUri,
+      ),
+      valuation_date: `${String(params.context.rollYear)}-01-01`,
+      valuation_method_type: `FL_DOR_NAL_${params.context.certificationStatus.toUpperCase()}`,
+      current_avm_value: readNumber(params.row.JV),
+      source_payload: payload,
+    }),
+  };
+}
+
+function mapTaxAuthorityRow(params: {
+  readonly row: FloridaNalRawRow;
+  readonly parcelId: string;
+  readonly propertySourceRecordKey: string;
+  readonly taxSourceRecordKey: string;
+  readonly context: FloridaNalContext;
+}): PreparedRow | null {
+  const authorityCode = readString(params.row.TAX_AUTH_CD);
+  if (authorityCode === null) return null;
+  const payload = {
+    authority_account_identifier: authorityCode,
+    roll_year: params.context.rollYear,
+  };
+  return {
+    tableName: "tax_authorities",
+    references: {
+      propertySourceRecordKey: params.propertySourceRecordKey,
+      taxSourceRecordKey: params.taxSourceRecordKey,
+    },
+    values: compactObject({
+      ...metadata(
+        sourceKey(
+          params.parcelId,
+          "tax_authority",
+          String(params.context.rollYear),
+        ),
+        payload,
+        params.context.sourceArtifactUri,
+      ),
+      request_identifier: params.parcelId,
+      authority_account_identifier: authorityCode,
+      authority_category: "Florida DOR tax authority code",
+      source_payload: payload,
+    }),
+  };
+}
+
+function mapTaxExemptionRows(params: {
+  readonly row: FloridaNalRawRow;
+  readonly parcelId: string;
+  readonly taxSourceRecordKey: string;
+  readonly context: FloridaNalContext;
+}): PreparedRow[] {
+  return Object.entries(params.row).flatMap(([fieldName, rawValue]) => {
+    if (!EXEMPTION_FIELD_PATTERN.test(fieldName)) return [];
+    const exemptionValue = readNumber(rawValue);
+    if (exemptionValue === null || exemptionValue <= 0) return [];
+    const payload = {
+      exemption_type: fieldName,
+      exemption_value: exemptionValue,
+      roll_year: params.context.rollYear,
+    };
+    return [
+      {
+        tableName: "tax_exemptions" as const,
+        references: { taxSourceRecordKey: params.taxSourceRecordKey },
+        values: compactObject({
+          ...metadata(
+            sourceKey(
+              params.parcelId,
+              "tax_exemption",
+              `${String(params.context.rollYear)}:${fieldName}`,
+            ),
+            payload,
+            params.context.sourceArtifactUri,
+          ),
+          request_identifier: params.parcelId,
+          exemption_type: fieldName,
+          exemption_value: exemptionValue,
+          tax_year: params.context.rollYear,
+          source_payload: payload,
+        }),
+      },
+    ];
+  });
+}
+
+function mapSaleRow(params: {
+  readonly row: FloridaNalRawRow;
+  readonly slot: number;
+  readonly parcelId: string;
+  readonly propertySourceRecordKey: string;
+  readonly context: FloridaNalContext;
+}): PreparedRow | null {
+  const suffix = String(params.slot);
+  const salePrice = readNumber(params.row[`SALE_PRC${suffix}`]);
+  const saleYear = readInteger(params.row[`SALE_YR${suffix}`]);
+  const saleMonth = readInteger(params.row[`SALE_MO${suffix}`]);
+  const instrumentNumber = readString(params.row[`CLERK_NO${suffix}`]);
+  const deedBook = readString(params.row[`OR_BOOK${suffix}`]);
+  const deedPage = readString(params.row[`OR_PAGE${suffix}`]);
+  if (
+    salePrice === null &&
+    saleYear === null &&
+    instrumentNumber === null &&
+    deedBook === null
+  ) {
+    return null;
+  }
+  const payload = {
+    sale_year: saleYear,
+    sale_month: saleMonth,
+    qualification_code: readString(params.row[`QUAL_CD${suffix}`]),
+    vacant_improved_code: readString(params.row[`VI_CD${suffix}`]),
+    multi_parcel_sale_code: readString(
+      params.row[`MULTI_PAR_SAL${suffix}`],
+    ),
+    sale_change_code: readString(params.row[`SAL_CHNG_CD${suffix}`]),
+  };
+  return {
+    tableName: "sales_histories",
+    references: {
+      propertySourceRecordKey: params.propertySourceRecordKey,
+    },
+    values: compactObject({
+      ...metadata(
+        sourceKey(
+          params.parcelId,
+          "sales_history",
+          `${String(params.context.rollYear)}:${suffix}`,
+        ),
+        payload,
+        params.context.sourceArtifactUri,
+      ),
+      request_identifier: params.parcelId,
+      purchase_price_amount: salePrice,
+      sale_type:
+        payload.qualification_code === null
+          ? null
+          : `FL_DOR_QUAL_${payload.qualification_code}`,
+      deed_book: deedBook,
+      deed_page: deedPage,
+      instrument_number: instrumentNumber,
+      source_payload: payload,
+    }),
+  };
+}
+
+function metadata(
+  sourceRecordKey: string,
+  sourcePayload: unknown,
+  sourceArtifactUri: string,
+): ReturnType<typeof buildSourceMetadata> {
+  return buildSourceMetadata({
+    sourceSystem: FLORIDA_DOR_NAL_SOURCE_SYSTEM,
+    sourceRecordKey,
+    sourcePayload,
+    sourceArtifactUri,
+  });
+}
+
+function sourceKey(
+  parcelId: string,
+  classType: string,
+  localKey: string,
+): string {
+  return `${FLORIDA_DOR_NAL_SOURCE_SYSTEM}:${parcelId}:${classType}:${localKey}`;
+}
+
+function requireDorUseCode(value: unknown): string {
+  const code = readString(value);
+  if (code === null || !/^\d{3}$/.test(code)) {
+    throw new Error("NAL DOR use code must be three digits");
+  }
+  return code;
+}
+
+function requireInteger(value: unknown, fieldName: string): number {
+  const parsed = readInteger(value);
+  if (parsed === null) throw new Error(`NAL ${fieldName} is missing`);
+  return parsed;
+}
+
+function nonnegativeDifference(
+  left: unknown,
+  right: unknown,
+): number | null {
+  const leftNumber = readNumber(left);
+  const rightNumber = readNumber(right);
+  if (leftNumber === null || rightNumber === null) return null;
+  return Math.max(0, leftNumber - rightNumber);
+}
+
+const _sourceSystemTypeCheck: SourceSystem = FLORIDA_DOR_NAL_SOURCE_SYSTEM;
+void _sourceSystemTypeCheck;
