+/**
+ * Keep the standardized Florida DOR NAL value row authoritative for a tax year.
+ *
+ * A final-certified NAL record cannot be downgraded by a preliminary replay.
+ * County live-appraiser artifacts may fill a year before NAL arrives, but they
+ * cannot overwrite an existing NAL row afterward.
+ *
+ * @param targetTableSql - Qualified and quoted taxes table name.
+ * @returns SQL predicate for the taxes `ON CONFLICT DO UPDATE` clause.
+ */
+function buildTaxRollPrecedenceGuard(targetTableSql: string): string {
+  const targetStatus = `${targetTableSql}."source_payload" ->> 'certification_status'`;
+  const incomingStatus = `EXCLUDED."source_payload" ->> 'certification_status'`;
+  return [
+    " WHERE (",
+    `EXCLUDED."source_system" = 'florida_dor_nal'`,
+    "AND (",
+    `${targetTableSql}."source_system" <> 'florida_dor_nal'`,
+    `OR ${targetStatus} IS DISTINCT FROM 'final_certified'`,
+    `OR ${incomingStatus} = 'final_certified'`,
+    ")",
+    ") OR (",
+    `${targetTableSql}."source_system" <> 'florida_dor_nal'`,
+    `AND EXCLUDED."source_system" <> 'florida_dor_nal'`,
+    `AND ${targetTableSql}."source_record_hash" IS DISTINCT FROM EXCLUDED."source_record_hash"`,
+    ")",
+  ].join(" ");
+}
