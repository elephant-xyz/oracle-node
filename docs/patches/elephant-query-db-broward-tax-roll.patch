+import { readFile } from "node:fs/promises";
+
+import { describe, expect, it } from "vitest";
+
+import {
+  BROWARD_DOR_COUNTY_NUMBER,
+  classifyFloridaDorUseCode,
+  mapFloridaNalRow,
+  requireFloridaNalParcelId,
+  type FloridaNalContext,
+  type FloridaNalRawRow,
+} from "../src/loader/florida-nal.js";
+import { buildBulkMergeSql } from "../src/loader/bulk.js";
+
+const CONTEXT: FloridaNalContext = {
+  countyName: "Broward",
+  countyNumber: BROWARD_DOR_COUNTY_NUMBER,
+  stateCode: "FL",
+  jurisdictionKey: "broward_appraiser",
+  rollYear: 2026,
+  certificationStatus: "preliminary",
+  retrievedAt: "2026-08-29T22:49:05Z",
+  sourceArtifactUri:
+    "https://floridarevenue.com/example/Broward%20Preliminary%20NAL%202026.zip",
+  sourceSha256:
+    "a60bc20f212716fe4d22673d14dc630ebb959ee13c1ed474b7451b36b2c94d9f",
+  existingPropertySourceRecordKey: null,
+};
+
+const BASE_ROW: FloridaNalRawRow = {
+  CO_NO: "16",
+  PARCEL_ID: "504108BJ0140",
+  FILE_T: "R",
+  ASMNT_YR: "2026",
+  DOR_UC: "004",
+  PA_UC: "04",
+  JV: "500000",
+  AV_SD: "400000",
+  AV_NSD: "390000",
+  TV_SD: "350000",
+  TV_NSD: "340000",
+  JV_HMSTD: "300000",
+  AV_HMSTD: "250000",
+  AV_CLASS_USE: "0",
+  LND_VAL: "50000",
+  ACT_YR_BLT: "2001",
+  EFF_YR_BLT: "2010",
+  TOT_LVG_AREA: "1250",
+  NO_BULDNG: "",
+  NO_RES_UNTS: "1",
+  OWN_NAME: "PUBLIC SOURCE OWNER",
+  OWN_ADDR1: "PO BOX 123",
+  OWN_CITY: "FORT LAUDERDALE",
+  OWN_STATE: "FL",
+  OWN_ZIPCD: "33302",
+  OWN_STATE_DOM: "FL",
+  S_LEGAL: "UNIT 140 TEST CONDOMINIUM",
+  TAX_AUTH_CD: "0512",
+  TWN: "50",
+  RNG: "42",
+  SEC: "08",
+  PHY_ADDR1: "100 TEST AVE UNIT 140",
+  PHY_CITY: "FORT LAUDERDALE",
+  PHY_ZIPCD: "33301",
+  EXMPT_01: "25000",
+  EXMPT_02: "25000",
+  SALE_PRC1: "450000",
+  SALE_YR1: "2025",
+  SALE_MO1: "06",
+  QUAL_CD1: "01",
+  OR_BOOK1: "12345",
+  OR_PAGE1: "678",
+};
+
+describe("Florida DOR NAL mapping", () => {
+  it("preserves alphanumeric and leading-zero parcel identifiers as strings", () => {
+    expect(requireFloridaNalParcelId("504108BJ0140")).toBe("504108BJ0140");
+    expect(requireFloridaNalParcelId("004108BJ0140")).toBe("004108BJ0140");
+    expect(() => requireFloridaNalParcelId("4108BJ0140")).toThrow(
+      /malformed/,
+    );
+    expect(() => requireFloridaNalParcelId(4108)).toThrow(/missing/);
+  });
+
+  it("creates a null-geometry condominium property for a tax-roll-only unit", () => {
+    const mapped = mapFloridaNalRow(BASE_ROW, CONTEXT);
+    expect(mapped.parcelId).toBe("504108BJ0140");
+    expect(mapped.isCondominium).toBe(true);
+    expect(mapped.createdCanonicalProperty).toBe(true);
+    expect(mapped.exemptionCount).toBe(2);
+    expect(mapped.saleCount).toBe(1);
+    expect(mapped.rows.some((row) => row.tableName === "geometries")).toBe(
+      false,
+    );
+
+    const property = mapped.rows.find(
+      (row) => row.tableName === "properties",
+    );
+    expect(property?.values).toMatchObject({
+      parcel_identifier: "504108BJ0140",
+      request_identifier: "504108BJ0140",
+      ownership_estate_type: "Condominium",
+      property_type: "Unit",
+      property_usage_type: "Residential",
+      structure_form: "ApartmentUnit",
+    });
+
+    const tax = mapped.rows.find((row) => row.tableName === "taxes");
+    expect(tax?.values).toMatchObject({
+      property_market_value_amount: 500_000,
+      property_assessed_value_amount: 390_000,
+      property_building_amount: 450_000,
+      property_land_amount: 50_000,
+      property_taxable_value_amount: 340_000,
+      county_taxable_value_amount: 340_000,
+      school_taxable_value_amount: 350_000,
+      tax_year: 2026,
+    });
+    expect(tax?.values).not.toHaveProperty("property_exemption_amount");
+  });
+
+  it("attaches NAL facts to an existing appraiser property without duplicating it", () => {
+    const sourceRecordKey =
+      "broward_appraiser:504108BJ0140:property:property";
+    const mapped = mapFloridaNalRow(BASE_ROW, {
+      ...CONTEXT,
+      existingPropertySourceRecordKey: sourceRecordKey,
+    });
+    expect(mapped.createdCanonicalProperty).toBe(false);
+    expect(mapped.rows.some((row) => row.tableName === "properties")).toBe(
+      false,
+    );
+    expect(mapped.rows.some((row) => row.tableName === "parcels")).toBe(false);
+    for (const tableName of [
+      "ownerships",
+      "taxes",
+      "property_valuations",
+      "sales_histories",
+      "tax_authorities",
+    ]) {
+      const row = mapped.rows.find((candidate) => candidate.tableName === tableName);
+      expect(row?.references?.propertySourceRecordKey).toBe(sourceRecordKey);
+    }
+  });
+
+  it("preserves exemption codes and does not invent a sale day", () => {
+    const mapped = mapFloridaNalRow(BASE_ROW, CONTEXT);
+    const exemptions = mapped.rows.filter(
+      (row) => row.tableName === "tax_exemptions",
+    );
+    expect(
+      exemptions.map((row) => row.values.exemption_type).sort(),
+    ).toEqual(["EXMPT_01", "EXMPT_02"]);
+    expect(
+      exemptions.every(
+        (row) =>
+          row.references?.taxSourceRecordKey ===
+          "florida_dor_nal:504108BJ0140:tax:2026",
+      ),
+    ).toBe(true);
+    const sale = mapped.rows.find(
+      (row) => row.tableName === "sales_histories",
+    );
+    expect(sale?.values).not.toHaveProperty("ownership_transfer_date");
+    expect(sale?.values.source_payload).toMatchObject({
+      sale_year: 2025,
+      sale_month: 6,
+      qualification_code: "01",
+    });
+  });
+
+  it("maps broad DOR categories without local-use-code guesses", () => {
+    expect(classifyFloridaDorUseCode("000", { NO_BULDNG: "0" })).toMatchObject({
+      build_status: "VacantLand",
+      property_type: "LandParcel",
+      property_usage_type: "Residential",
+    });
+    expect(classifyFloridaDorUseCode("048", {})).toMatchObject({
+      property_usage_type: "Industrial",
+    });
+    expect(classifyFloridaDorUseCode("071", {})).toMatchObject({
+      property_usage_type: "Church",
+    });
+    expect(classifyFloridaDorUseCode("094", {})).toMatchObject({
+      ownership_estate_type: "RightOfWay",
+    });
+  });
+
+  it("uses property/year tax conflicts with DOR certification precedence", () => {
+    const sql = buildBulkMergeSql({
+      stageTableName: "nal_stage",
+      tableName: "taxes",
+      columns: [
+        { table_name: "taxes", column_name: "tax_id", ordinal_position: 1 },
+        { table_name: "taxes", column_name: "property_id", ordinal_position: 2 },
+        { table_name: "taxes", column_name: "tax_year", ordinal_position: 3 },
+        { table_name: "taxes", column_name: "source_system", ordinal_position: 4 },
+        { table_name: "taxes", column_name: "source_record_key", ordinal_position: 5 },
+        { table_name: "taxes", column_name: "source_record_hash", ordinal_position: 6 },
+        { table_name: "taxes", column_name: "source_payload", ordinal_position: 7 },
+      ],
+    });
+    expect(sql).toContain('ON CONFLICT ("property_id", "tax_year")');
+    expect(sql).toContain("EXCLUDED.\"source_system\" = 'florida_dor_nal'");
+    expect(sql).toContain("final_certified");
+  });
+
+  it("ships the resumable NAL schema and never defines NAP ingestion", async () => {
+    const migration = await readFile(
+      new URL("../migrations/0010_florida_nal_tax_roll.sql", import.meta.url),
+      "utf8",
+    );
+    expect(migration).toContain('CREATE TABLE IF NOT EXISTS "tax_exemptions"');
+    expect(migration).toContain('CREATE TABLE IF NOT EXISTS "tax_authorities"');
+    expect(migration).toContain(
+      '"ingest_control"."florida_nal_chunks"',
+    );
+    expect(migration).not.toMatch(/\bNAP\b/);
+  });
+});
